MABAEIREAM_LISTEN=127.0.0.1:9781
MABAEIREAM_MEDIA_DIR=/srv/mabaeiream/media
MABAEIREAM_DB=/var/lib/mabaeiream/data/mabaeiream.sqlite3
MABAEIREAM_MAX_DOWNLOAD_BYTES=21474836480
MABAEIREAM_MAX_UPLOAD_BYTES=21474836480
# Optional; defaults to `yt-dlp` found on the service PATH.
MABAEIREAM_YTDLP=/usr/local/bin/yt-dlp
MABAEIREAM_PUBLIC_BASE_URL=https://ahura.site/mabaeiream
MABAEIREAM_RTMPS_SERVER_URL=rtmps://ahura.site:1936/mabaeiream
# Provision a unique 256-bit URL-safe key outside this example file.
MABAEIREAM_LIVE_STREAM_KEY=replace-with-random-url-safe-secret
# TURN relay settings for cross-network voice calls. Use coturn's REST API secret.
# The VPS has no public IPv6 route while ahura.site advertises AAAA, so plain TURN uses IPv4 directly.
MABAEIREAM_TURN_URLS=turn:146.19.130.38:3478?transport=udp,turn:146.19.130.38:3478?transport=tcp,turns:ahura.site:5349?transport=tcp
MABAEIREAM_TURN_SECRET=replace-with-random-64-character-hex-secret
